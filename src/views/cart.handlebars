<section>
        {{#if selectedCart.products.length}}
            <nav class="navbar">
                <h1>Tu carrito</h1>
                <h2>Indentificador: {{selectedCart._id}}</h2>
                <button class="volver"><a href="http://localhost:8080/products">Volver</a></button>
            </nav>
             <article class="productsSection">
                <h3>Productos agregados al carrito</h3>
                <div class="productsConteiner">
            {{#each selectedCart.products}}
            <div class="product">
                <h2>Nombre: {{this.product.title}}</h2>
                <p>Descripcion: {{this.product.description}}</p>
                <p class="price">{{this.product.price}}</p>
                <p>Codigo: {{this.product.code}}</p>
                <p>Status: {{this.product.status}}</p>
                <p>Stock: {{this.product.stock}}</p>
                <p>Imagen: {{this.product.thumbnails}}</p>
                <p>Categoria: {{this.product.category}}</p>
                <button class="eliminar" data-prod="{{this.product._id}}" data-cart="{{../selectedCart._id}}">Eliminar del carrito</button>
            </div>
        {{/each}}
            </div>
            </article>
            <article class="compraConteiner">
                <button class="compra" id="buy" data-cart="{{selectedCart._id}}">Efectuar Compra del Carrito</button>
            </article>
            {{else}}
            <article class="noProductsConteiner">
             <nav class="navbar">
                <h1>Tu carrito</h1>
                <h2>Indentificador: {{selectedCart._id}}</h2>
                <button class="volver"><a href="http://localhost:8080/products">Volver</a></button>
            </nav>
            <div class="noProducts">
                <h2>No hay productos agregados al carrito</h2>
            </div>
            </article>
        {{/if}}
        
   
</section>

<script src="/js/cart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
















